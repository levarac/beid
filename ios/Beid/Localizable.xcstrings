    "Account": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アカウント"
          }
        }
      }
    },
    "Active": {
      "comment": "Generic on/off status label shown next to a colored dot — used for the Bluetooth power state (Account sheet) and for the currently-broadcasting entry in the venue-device reassignment history (gh#138).",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有効"
          }
        }
      }
    },
    "Added to your collection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コレクションに追加しました。"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アドレス"
          }
        }
      }
    },
    "Allow Bluetooth": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetoothを許可"
          }
        }
      }
    },
    "Approve the connection in Coinbase Wallet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coinbase Wallet で接続を承認してください"
          }
        }
      }
    },
    "Approve the connection in MetaMask": {
      "comment": "Instruction shown while beid waits for the user to approve the direct connection in the MetaMask app.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MetaMask で接続を承認してください"
          }
        }
      }
    },
    "Ask the event organizer for the code. This joins the event directly, without connecting a wallet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "イベントコードは主催者に確認してください。ウォレットを接続せずに、直接イベントに参加できます。"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "自動"
          }
        }
