    "beid can't sense events or collect proofs while Bluetooth is off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid no puede detectar eventos ni recopilar pruebas mientras el Bluetooth esté desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid ne peut pas détecter d'événements ni collecter de preuves tant que le Bluetooth est désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetoothがオフの間、beidはイベントを検知したり証明を収集したりできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
