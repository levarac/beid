    "account.bluetooth.relayNote": {
      "comment": "Note under the Bluetooth row on the Account sheet: while this phone is at an event it can pass that event's details on to phones nearby, so the event still reaches the edges of a venue (beid#367). Says what the phone does, not how the protocol does it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this phone is at an event, beid can pass the event's details on to phones nearby, so people across the venue can still find it."
          }
        }
      }
    },
    "account.joinEvent.label": {
      "comment": "Menu row in the Account sheet that opens the manual event-code entry form. Distinct from that form's own submit button, which is also labeled \"Join Event\" in English but is a separate translation unit and may need different wording in other languages.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join Event"
          }
        }
      }
    },
    "account.wallet.connectedVia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected via %@"
          }
        }
      }
    },
    "beid": {
      "comment": "Brand name, appears as the app title on the Welcome screen. Not translated in any target locale."
    },
    "beid can't sense events or collect proofs while Bluetooth is off.": {},
    "beid couldn't connect to your wallet. Check your connection and try again.": {},
    "beid couldn't join that event. Check the code and try again.": {},
    "beid found a nearby event signal.": {},
    "beid lost the connection to %@. Move closer and we'll pick it back up automatically.": {},
    "beid senses nearby events and people over Bluetooth Low Energy — that's how it proves you were really there.": {},
    "beid uses your wallet to sign proofs of event attendance.": {},
    "e.g. ETHTOKYO2026": {
      "comment": "Placeholder shown in the empty event-code text field. Keep the invented example code (ETHTOKYO2026) as-is; translate only the localized equivalent of \"e.g.\"."
    },
    "Collection": {
      "comment": "Noun: title of the Collection Home screen, showing the user's collected proofs."
    },
    "collection.eventCount": {
      "comment": "Caption above the Collection Home grid: count of distinct events the user has collected a proof for (grouped by eventCode; each proof recorded before eventCode existed counts as its own event). \"Proof\" here is the mass-noun collected fact, per DESIGN.md §15’s vocabulary (a proof is collected — the object of \"collect\" is proof, never the event itself), and the number scopes how many events that applies across; it is not a raw count of recording sessions — a user who scanned the same event twice still counts as one event here, and this caption does not imply exactly one Proof record per event.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Proof collected from %lld event"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Proof collected from %lld events"
                }
              }
            }
          }
        }
      }
    },
    "collection.proofCount": {
      "comment": "Caption above the Collection Home grid, showing how many proofs the user has collected so far.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld proof collected"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld proofs collected"
                }
              }
            }
          }
        }
      }
    },
    "Start sensing at an event to collect your first proof.": {},
    "proofCard.sessionCount": {
      "comment": "Caption on a Collection Home card for an event recorded more than once (the user re-scanned the same event in a separate app session). Count of distinct recorded sessions for this event, not devices or peers. Also reused, composed after a comma, inside proofCard.accessibilityLabel's VoiceOver text for the same fact when sessionCount > 1.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld session"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sessions"
                }
              }
            }
          }
        }
      }
    },
    "proofCard.accessibilityLabel": {
      "comment": "VoiceOver label for one proof card in the Collection Home grid — composed from the event name and collection date. When the event was recorded in more than one session, proofCard.sessionCount's own text (e.g. \"3 sessions\") is appended after a comma, so VoiceOver users get the same session-count fact sighted users see in the card's secondary caption.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof of %1$@, %2$@"
          }
        }
      }
    },
    "Connect a wallet to seal your attendance to this event.": {},
    "Seal with connected wallet": {},
    "Sealed": {},
    "Couldn't seal attendance": {},
    "beid couldn't finish sealing your attendance with this wallet.": {},
    "scan.binding.title": {
      "comment": "Event name, e.g. 'ETH Tokyo 2026 confirmed' — heading on the wallet connect+binding prompt.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ confirmed"
          }
        }
      }
    },
    "scan.binding.sealedSubtitle": {
      "comment": "Confirmation after the wallet-binding signature succeeds; event name is interpolated, e.g. 'Your attendance to ETH Tokyo 2026 is sealed.'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your attendance to %@ is sealed."
          }
        }
      }
    },
    "scan.binding.declined": {
      "comment": "Reason shown when the user's wallet app declines the binding signature request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined in wallet"
          }
        }
      }
    },
    "scan.binding.notConnected": {
      "comment": "Reason shown when the binding signature request has no connected wallet session to use.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet not connected"
          }
        }
      }
    },
    "scan.binding.timedOut": {
      "comment": "Reason shown when the wallet app never responds to the binding signature request within the timeout.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet did not respond in time"
          }
        }
      }
    },
    "scan.binding.smartWalletUnsupported": {
      "comment": "Reason shown when beid recognizes the wallet's signature as an ERC-6492 smart-contract-wallet format (e.g. Safe, other smart accounts). beid does not support this wallet type yet. Do not imply the user can fix this by trying again or reconnecting — it cannot succeed until beid adds support.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This wallet type isn't supported yet"
          }
        }
      }
    },
    "scan.binding.differentWalletHint": {
      "comment": "Shown under the unsupported-wallet failure (scan.binding.smartWalletUnsupported). Tells the participant that the only way to use a different wallet is to end the current recording session (the X on the scan screen) and then use Disconnect Wallet in the Account screen. Do not imply that retrying or reconnecting the same wallet will work.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use a different wallet, end this session, then disconnect in Account."
          }
        }
      }
    },
    "scan.binding.verificationFailed": {
      "comment": "Reason shown when beid could not verify this wallet-binding attempt: stale/malformed local state, a wallet signature of the wrong length, or a signature that cryptographically recovers to a different address than the one claimed. Distinct from the ERC-6492 smart-wallet case (scan.binding.smartWalletUnsupported), which has its own reason. The user can try again — this case covers failures that could be transient (e.g. transport corruption), unlike the smart-wallet case.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify this wallet"
          }
        }
      }
    },
    "DETECTED": {
      "comment": "Status badge on the event card during BLE sensing, not audio/video recording."
    },
    "RECORDING": {
      "comment": "Status badge on the event card during BLE sensing, not audio/video recording."
    },
    "PAUSED": {
      "comment": "Status badge on the event card during BLE sensing, not audio/video recording."
    },
    "Verification starts automatically — stay nearby": {},
    "scan.recording.caption": {
      "comment": "Cumulative count of distinct nearby devices sensed at the event, each counted once however long it stayed; no fixed target. Do NOT translate this as mutual, two-way, or reciprocal confirmation: this device cannot tell whether a peer also observed it, so any such wording would overclaim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording your attendance automatically · %lld devices sensed"
          }
        }
      }
    },
    "scan.recording.diagnosticCaption": {
      "comment": "Temporary diagnostic line on the Recording screen (beid#218, DECISIONS 2026-08-20) — not permanent product UI, does not need to survive #141's rebuild, but ships to real TestFlight/production builds (not #if DEBUG) because a live multi-device field test needs to read these counters without a debugger attached. \"Identified\" is SensingCoordinator.devicesVerified: distinct nearby devices whose proximity identifier (RPID) was resolved to a display ID. \"Unidentified\" is SensingCoordinator.unidentifiedRpidCount: proximity identifiers observed but not yet resolved to a display ID — radio is arriving, but the device could not be identified. A large unidentified count with a flat identified count points at an identification failure; both flat points at nothing arriving at all — opposite fixes, which is why both numbers must be visible together. Do NOT translate this as mutual, two-way, or reciprocal confirmation of any kind — neither number says anything about whether a peer observed this device back (the protocol carries no such signal, DECISIONS 2026-08-09). Same bar as this file's `scan.recording.caption` translator comment on the line above this one.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics: %1$lld identified · %2$lld unidentified"
          }
        }
      }
    },
    "Transparency": {
      "comment": "Screen title (also reused as the ItemDetailView row label linking to this screen): the name of the screen showing a participant the status of their own data (recorded/sent/published/verified). Noun referring to open, checkable data status, not visual/window transparency or opacity.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparency"
          }
        }
      }
    },
    "Participation": {
      "comment": "Tier 1 of 3 on the Transparency screen: whether this device has joined the event at all. Distinct from the \"Participation record\" tier below it, which is about what has happened to the data after joining (stored/sent/published), not about the join action itself.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participation"
          }
        }
      }
    },
    "Joined": {
      "comment": "Value shown under the \"Participation\" tier: whether this device has joined the event. \"Joined\" here means the join action was taken, not a social/group-membership sense of the word.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined"
          }
        }
      }
    },
    "Not joined": {
      "comment": "Value shown under the \"Participation\" tier: whether this device has joined the event. \"Joined\" here means the join action was taken, not a social/group-membership sense of the word.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not joined"
          }
        }
      }
    },
    "Participation record": {
      "comment": "Tier 2 of 3 on the Transparency screen: what has happened to this device's sensing data after joining (recorded on-device / sent to a report server / included in published data). Distinct from \"Verified proof\" below it, which is about third-party verification, not data handling.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participation record"
          }
        }
      }
    },
    "Sent": {
      "comment": "Sub-state row under \"Participation record\": whether this device's sensing data has been transmitted to a report server for this event. Available once at least one submission has reached the SUBMITTING or ACCEPTED durable state (beid#292); report-submission code exists in the app today but is gated off in production by the BeidReportSubmissionEnabled build setting, so this reflects genuinely stored state, not a permanently-unbuilt capability like the rows below it. Shows \"Not yet available\" (not a failed-send state) before any submission for this event has been attempted.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        }
      }
    },
    "Included in published data": {
      "comment": "Sub-state row under \"Participation record\": whether this device's data has been incorporated into the report server's published dataset. Always shows \"Not yet available\" today because no report server or publishing pipeline exists yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Included in published data"
          }
        }
      }
    },
    "Verified proof": {
      "comment": "Tier 3 of 3 on the Transparency screen: whether this device's participation has passed third-party verification (a status that would include a pending sub-state once it exists). Always shows \"Not yet available\" today because no verifier exists yet in the product. Distinct from the existing, always-true \"Verified\" status shown on the Proof Detail screen, which is about local BLE self-evidence, not third-party verification.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified proof"
          }
        }
      }
    },
    "transparency.notYetAvailable": {
      "comment": "Status for a participation-record or verified-proof row that has no data to show yet — either because the underlying capability isn't implemented in the product at all, or because it exists but hasn't happened for this event yet (e.g. no submission has been sent/received). This means there is nothing to report yet, not that an attempt was made and failed — do not translate as an error, warning, or declined state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet available"
          }
        }
      }
    },
    "scan.recording.mutualCount": {
      "comment": "Count of mutually-confirmed (two-way) observations — a distinct metric from the devices-sensed count in the line above it, not a synonym or a related total. This currently always displays as 0 because the on-device protocol has no way to detect when a nearby device also observed this device back; establishing that is a separate, later, off-device verification step. Do not translate this as if it always grows together with the devices-sensed count, and do not omit it or fold it into that line.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutual confirmations: %lld"
          }
        }
      }
    },
    "scan.recording.windowBuildup": {
      "comment": "Count of ENIN time-windows recorded for this session so far, shown as a simple running total. This is a coverage/buildup indicator, not a device or confirmation count — a window is \"recorded\" once its time interval has been observed and closed, independent of how many devices were present in it.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld window recorded"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld windows recorded"
                }
              }
            }
          }
        }
      }
    },
    "sigil.accessibilitySummary": {
      "comment": "VoiceOver summary spoken in place of the Proof Sigil, the generated circular mark on a proof. It replaces the whole drawing, so it is the only thing a VoiceOver user gets — keep all three numbers. The first number counts nearby people's devices whose presence was mutual (both devices confirmed each other); the second counts devices this device merely detected, without that confirmation; the two never overlap and together they are every device drawn. The third is how many time windows the whole mark spans, not a position or an index into them — \"window\" is the unit of recorded time, roughly a few seconds each, and is not a GUI window. On current builds the first number is always 0, because mutual confirmation is not measurable on the device yet and this project deliberately shows 0 rather than guessing; translate it as a real count of zero, never as \"unknown\" or \"not available\".",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld mutual, %2$lld detected, window %3$lld"
          }
        }
      }
    },
    "Venue Device": {},
    "Venue Device (Signed)": {
      "comment": "Account-sheet row opening the signed venue-serving screen (gh#432), shown just below the plain \"Venue Device\" row. \"Signed\" distinguishes the cryptographically signed container this screen serves from the unsigned hint the older row broadcasts — it does not mean the device or the user is signed in."
    },
    "Version": {},
    "Assignment": {
      "comment": "Section header on the venue-device organizer screen (gh#138) for the label + validity-period fields — not a task/homework assignment."
    },
    "Label": {
      "comment": "Text field on the venue-device organizer screen: the display name this device broadcasts to nearby attendees (Barnard B005 eventDisplayName), not a generic UI label element."
    },
    "Leave Event": {},
    "e.g. Doorway A": {
      "comment": "Placeholder example shown inside the empty venue-device label field."
    },
    "Starts": {
      "comment": "Label for the validity-period start date/time picker on the venue-device organizer screen, not a verb describing an event beginning."
    },
    "Ends": {
      "comment": "Label for the validity-period end date/time picker on the venue-device organizer screen."
    },
    "Beid does not verify this broadcast. Anyone nearby with the app can see the name you set here.": {
      "comment": "Organizer-facing trust disclaimer shown under the label field on the venue-device screen (PM-approved exact copy, docs/specs/participation-surface.md §3.2 — do not edit without new sign-off). \"This broadcast\" refers to the Bluetooth broadcast this screen's toggle turns on, not the app itself. \"The name you set here\" refers to the Label field on this same screen."
    },
    "Enter a label to identify this device.": {},
    "That label isn't valid. Try a shorter name using regular text.": {},
    "End time must be after the start time.": {},
    "Join an event first, then come back to set up this device.": {},
    "History": {
      "comment": "Section header on the venue-device organizer screen: a read-only list of past assignments (label + validity period), shown below the current assignment fields."
    },
    "No assignments yet.": {},
    "venueDevice.history.assignedAt": {
      "comment": "Venue-device reassignment-history row: when this assignment was created. %@ is a pre-formatted, locale-aware date/time string.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigned %@"
          }
        }
      }
    },
    "venueDevice.history.validityRange": {
      "comment": "Venue-device reassignment-history row: the assignment's validity period. %1$@ is the pre-formatted start date/time, %2$@ the end date/time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid %1$@ – %2$@"
          }
        }
      }
    },
    "Devices mutually confirmed": {
      "comment": "Headline metric label on the Participation summary screen, paired with a value. This is the mutually-confirmed (two-way) device count for the whole session, a different metric from any all-observation device count shown elsewhere in the app (see beid#142's \"Devices sensed\"/\"Mutual confirmations\" precedent) — the reciprocity signal this depends on does not exist on-device yet, so this metric never shows a numeric value: the value shown next to this label is always a \"cannot be determined on this device\" state (see `participationSummary.mutualCount.unavailable`), never a number including 0. Do not translate this as if it always grows together with a devices-sensed count, and do not substitute an estimate for it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices mutually confirmed"
          }
        }
      }
    },
    "No time bands recorded for this session": {
      "comment": "Shown on the Participation summary screen instead of the time-band list when a session-aggregate snapshot exists for this proof but its band series is empty (an honest, real absence of recorded data for this session) — distinct from the screen's \"Not yet available\" state, which means no snapshot exists at all. Do not merge the wording of these two states.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time bands recorded for this session"
          }
        }
      }
    },
    "Participation summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participation summary"
          }
        }
      }
    },
    "participationSummary.bandBuildup.row": {
      "comment": "One row in the time-band buildup list on the Participation summary screen. The first number is the band's absolute index — bands are anchored at an absolute origin, not the session start, and a band spans a fixed count of ENIN time-windows, never a duration in seconds or minutes, so do not translate it as a clock time or a duration. The second number is the distinct-device count sensed during that band, over the all-observation scope (not the mutually-confirmed scope shown in the headline metric above this list) — do not translate this as mutual/reciprocal confirmation. A gap between two consecutive rows' band index numbers means that time period was not recorded at all (for example a late arrival or a signal-loss interruption), not that it recorded zero devices — never phrase this row or the list around it as if every band number appears.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band %1$lld: %2$lld devices sensed"
          }
        }
      }
    },
    "participationSummary.sessionList.header": {
      "comment": "Header above the per-session list on the Participation summary screen for an event recorded more than once. Count of distinct recording sessions for this event, not devices.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld session recorded for this event"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sessions recorded for this event"
                }
              }
            }
          }
        }
      }
    },
    "participationSummary.sessionList.row.mutualCount": {
      "comment": "Trailing value on one row of the per-session list on the Participation summary screen: the mutually-confirmed device count for that one specific session, matching the scope of the headline metric shown on the single-session Participation summary screen. Not a duration, not an index, not the event-wide Transparency count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld confirmed"
          }
        }
      }
    },
    "participationSummary.mutualCount.unavailable": {
      "comment": "Value shown for the \"Devices mutually confirmed\" headline metric on the Participation summary screen — unconditionally, regardless of whether a session-aggregate snapshot exists for this proof. The mutual (two-way) device count cannot be measured on this device at all: the protocol only reports \"this device observed a peer,\" never \"the peer observed this device back,\" so establishing mutual confirmation requires reconciling two devices' signed records off-device (beid#144 stage 4, not yet built). This is a different, narrower reason than this screen's other \"Not yet available\" text (`participationSummary.notYetAvailable`, used when no session data was captured at all) — do not merge the two keys, and do not translate this as an error, warning, or declined state. Never show a numeric value (including 0) for this metric; DECISIONS 2026-08-20 (beid#222) settled that an honest-but-unmeasured 0 was read on real hardware as \"measured and got 0,\" which is misinformation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet available"
          }
        }
      }
    },
    "participationSummary.notYetAvailable": {
      "comment": "Status shown on the Participation summary screen when no session-aggregate snapshot was ever persisted for this proof: the session ended before the snapshot-writing feature existed, the write failed (best-effort, can fail silently), or the session never reached the recording phase at all. This means the data was never captured, not that an attempt was made and failed — do not translate as an error, warning, or declined state. Never confuse this key with `participationSummary.mutualCount.unavailable`, the headline metric's own \"not yet available\" text — a different, narrower reason (mutual confirmation is structurally unmeasurable on-device, not merely uncaptured).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet available"
          }
        }
      }
    },
    "Time-band buildup": {
      "comment": "Section label on the Participation summary screen, above a list of time-band rows. Each row below this label covers a fixed span of ENIN time-windows, not a fixed duration in seconds or minutes. A gap in the list (a band index that does not appear) means that time period was not recorded at all — for example the participant arrived late or had a signal-loss interruption — never that it recorded zero devices; do not phrase this heading as if the list shows every time period end to end.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time-band buildup"
          }
        }
      }
    },
    "View participation summary": {
      "comment": "Row label on Proof Detail linking to the Participation summary screen, which shows a post-session summary (mutually-confirmed device count and a time-band buildup) for this proof's recording session.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View participation summary"
          }
        }
      }
    },
    "Current": {
      "comment": "Trailing label on a Past Events row identifying the event this device is presently joined to. Refers to \"the event currently joined,\" not a generic adjective — distinct from any other use of the English word \"Current\" elsewhere in the app."
    },
    "No past events yet.": {
      "comment": "Empty state on the Past Events screen, shown when this device has never recorded a Proof for any event."
    },
    "Only events you've actually recorded a proof for are listed here.": {
      "comment": "Footer under the Past Events list, clarifying that a code that was typed and abandoned before recording completed does not appear."
    },
    "account.pastEvents.label": {
      "comment": "Menu row in the Account sheet that opens the list of previously joined events (beid#230), for rejoining one without retyping its code.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past Events"
          }
        }
      }
    },
    "transparency.mutualObservation": {
      "comment": "Sub-state row under \"Participation record\": whether two devices have confirmed they mutually sensed each other during this event. Always shows \"Not yet available\" today because there is no on-device reciprocity signal in the product yet — this is not a failed-measurement or zero-result state, the capability itself does not exist yet. Refers to two devices detecting each other, not audio/video observation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutual observation"
          }
        }
      }
    },
    "transparency.sent": {
      "comment": "Trailing value on the \"Sent\" sub-state row under \"Participation record\", shown once at least one submission for this event has actually been transmitted to a report server. Same word as the row's own label — confirming the label is now true, not a separate or more specific status.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        }
      }
    },
    "transparency.acceptanceReceipt": {
      "comment": "Sub-state row under \"Participation record\": whether the report server has confirmed receipt of at least one of this device's submissions for this event. Always shows \"Not yet available\" until a receipt has actually been verified and stored — a submission that was merely sent, with no confirmed receipt yet, is not enough for this row.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptance receipt"
          }
        }
      }
    },
    "transparency.received": {
      "comment": "Trailing value on the \"Acceptance receipt\" sub-state row under \"Participation record\", shown once the report server has actually confirmed receipt for at least one submission for this event. Not a separate status word like \"pending\" or \"delivered\" — it means the receipt itself is confirmed and stored.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Received"
          }
        }
      }
    },
    "No proofs yet today": {
      "comment": "Empty-state title on the Daily Summary screen when no proof has been collected yet today (local calendar day). Distinct from Collection Home's all-time empty state (\"No proofs yet\").",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No proofs yet today"
          }
        }
      }
    },
    "Proofs you collect today will show up here.": {
      "comment": "Empty-state body on the Daily Summary screen, directly under \"No proofs yet today\". Describes what will populate this list, not an instruction to act right now.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proofs you collect today will show up here."
          }
        }
      }
    },
    "Submission": {
      "comment": "Section header on the Daily Summary screen, above one line describing whether sending proofs to a report server is turned on for this build. Noun, not a verb/CTA.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submission"
          }
        }
      }
    },
    "collection.dailySummaryButton": {
      "comment": "Visible Today text control on Collection Home that opens the Daily Summary screen — a day-scoped rollup of proofs collected on the current local calendar day. Same word as the Daily Summary screen's navigation title; it means the current day, not a to-do list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "dailySummary.title": {
      "comment": "Navigation title of the Daily Summary screen: a day-scoped rollup of proofs collected on the current local calendar day. Refers to the current day, not a to-do list or calendar-app sense of \"Today\".",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "dailySummary.recordCount": {
      "comment": "Header above the Daily Summary screen's list of today's proofs: how many proofs (Proof records in ProofStore, not distinct events) were collected on the current local calendar day. Only shown when the day is non-empty — the empty-day state (\"No proofs yet today\") is a separate string.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld proof collected today"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld proofs collected today"
                }
              }
            }
          }
        }
      }
    },
    "dailySummary.submission.notSentYet": {
      "comment": "Submission status line on the Daily Summary screen, shown only when the BeidReportSubmissionEnabled build flag is on. States plainly that nothing has been transmitted to a report server yet — not a count, not a claim about verification.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent yet."
          }
        }
      }
    },
    "dailySummary.submission.disabledForBuild": {
      "comment": "Submission status line on the Daily Summary screen, shown when the BeidReportSubmissionEnabled build flag is off (the default today). Communicates that the sending feature exists but is switched off for this build — \"built, off,\" never \"not built\" — not that anything failed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending isn't turned on for this build."
          }
        }
      }
    },
    "Not submittable (count-only record)": {
      "comment": "Sub-state row under \"Participation record\": windows recorded with only a device count and no reporter RPID can never be submitted to a report server. This row makes that exclusion explicit instead of silently dropping those windows (levarac/dispatch#3).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not submittable (count-only record)"
          }
        }
      }
    },
    "wallet.restored.subtitle": {
      "comment": "Subtitle shown under the restored-wallet heading when a cached wallet address exists from a previous launch. %@ is the truncated wallet address, e.g. '0x1234...5678'. This address is a reference only, not a verified signer, until the user approves again in their wallet (dispatch#26 condition 4).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was used last time — shown for reference. Approve in your wallet to continue."
          }
        }
      }
    },
    "wallet.restored.continueButton": {
      "comment": "Primary button that resumes a previously connected wallet without picking it again. %@ is the truncated wallet address, e.g. '0x1234...5678'.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue as %@"
          }
        }
      }
    },
    "wallet.restored.connectDifferent": {
      "comment": "Secondary button next to a restored-wallet suggestion, for a user who wants to pick a different wallet instead of continuing with the one shown.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a different wallet"
          }
        }
      }
    },
    "Venue serving": {
      "comment": "Title of the venue signed-serving screen. 'Serving' means this device is making an event's signed information available to nearby devices."
    },
    "Bundle URL": {
      "comment": "Field label. The address of the public venue bundle file."
    },
    "Handoff URL": {
      "comment": "Field label. The address of the public handoff file that accompanies a bundle."
    },
    "Supply bundle": {
      "comment": "Button. Verb: fetch and verify the bundle at the addresses entered above."
    },
    "Reload stored bundle": {
      "comment": "Button. Verb: verify the previously stored bundle again from scratch."
    },
    "Source": {
      "comment": "Section header for where the venue bundle is fetched from."
    },
    "Radio": {
      "comment": "Section header for the Bluetooth radio's current state."
    },
    "Stop serving": {
      "comment": "Button. Verb: stop making the event's signed information available."
    },
    "Stored bundles are verified again each time they are loaded.": {
      "comment": "Explains that storing a bundle is not a shortcut past verification."
    },
    "Not serving.": {
      "comment": "Nothing is being made available to nearby devices."
    },
    "Fetching the bundle.": {
      "comment": "In progress: downloading or reading the bundle file."
    },
    "Verifying identity.": {
      "comment": "In progress: checking which event the bundle belongs to."
    },
    "Identity verified. Checking whether it may be served now.": {
      "comment": "Which event this is has been confirmed, but whether it is allowed to be served at this moment has not been decided yet. Deliberately does not name the event: the name is not available at this stage."
    },
    "This bundle could not be read.": {
      "comment": "The file was malformed or too large."
    },
    "The handoff does not match this bundle.": {
      "comment": "The two supplied files do not belong together."
    },
    "This bundle is for a deployment this app does not support.": {
      "comment": "'Deployment' is the operator environment the bundle was issued for."
    },
    "The registry could not be reached, so the bundle was not verified.": {
      "comment": "Network failure during verification. Nothing was judged invalid."
    },
    "This bundle came from a different registry source than the one configured.": {
      "comment": "The bundle's origin does not match this app's configured source."
    },
    "This event has no anchored record in the registry.": {
      "comment": "'Anchored record' is the registry entry that vouches for the event."
    },
    "The event definition in this bundle was rejected.": {
      "comment": "The event's own description failed verification."
    },
    "This event needs an entry code. Serving those is not supported yet.": {
      "comment": "Refusal shown when the loaded pack is for an event people join with an entry code. This app can only serve events that are open to anyone. \"Serving\" means making the event's information available to nearby devices."
    },
    "This device's clock is unavailable, so serving cannot be scheduled.": {
      "comment": "Without a clock the stop time cannot be honored, so nothing is served."
    },
    "This event has not started yet.": {
      "comment": "Too early to serve."
    },
    "This event's current lease has ended.": {
      "comment": "'Lease' is the bounded period this device was permitted to serve."
    },
    "There is no envelope covering the present moment.": {
      "comment": "'Envelope' is the signed record covering a period of time."
    },
    "The envelope covering now did not verify.": {
      "comment": "The signed record for the current period failed its signature check."
    },
    "A newer definition exists for this event. Load the current bundle.": {
      "comment": "The stored bundle has been superseded."
    },
    "The registry could not be reached, so eligibility is unknown.": {
      "comment": "Network failure while checking permission. Not a denial."
    },
    "Stopped.": {
      "comment": "Radio state: not advertising."
    },
    "Waiting for Bluetooth.": {
      "comment": "Radio state: Bluetooth is not ready yet but is expected to become ready."
    },
    "Advertising requested. The system has not confirmed it is on air.": {
      "comment": "Radio state. Deliberately hedged: the system reports advertising as started before the hardware confirms it and never sends a success signal, so this must not be worded as confirmed, broadcasting, or on air."
    },
    "The radio stopped.": {
      "comment": "Radio state: advertising ended because of a failure. The specific cause is shown beneath this."
    },
    "The signed container was rejected and nothing is being served.": {
      "comment": "The radio refused the signed bytes."
    },
    "Bluetooth is unavailable for this device.": {
      "comment": "Bluetooth is off, unauthorized, or unsupported."
    },
    "Advertising could not start.": {
      "comment": "The system refused to begin advertising."
    },
    "The device could not publish its discovery service.": {
      "comment": "The Bluetooth service other devices read from could not be set up."
    },
    "Only https and file sources are supported.": {
      "comment": "The address used an unsupported scheme."
    },
    "That address redirected elsewhere, so it was not followed.": {
      "comment": "Redirects are deliberately refused because the bytes would come from an address the operator did not name."
    },
    "That file is larger than a venue bundle may be.": {
      "comment": "Size limit refusal."
    },
    "That file could not be read.": {
      "comment": "Local file read failure."
    },
    "The bundle could not be fetched.": {
      "comment": "Network failure."
    },
    "https://": {
      "comment": "Placeholder text shown in an empty address field."
    },
    "venue.serving.storedSource": {
      "comment": "Shows where the currently stored venue bundle came from. The value is a host name or a file name, not a person or an event name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored source: %@"
          }
        }
      }
    },
    "venue.serving.servingUntil": {
      "comment": "The value is a time of day. This instant is fixed by the permit and is exclusive - broadcasting stops at it, it does not continue through it. \"Broadcasting\" is the word the venue screen uses throughout; it is not a claim that the radio is confirmed on air, which the radio section states separately.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadcasting until %@."
          }
        }
      }
    },
    "Copied": {
      "comment": "Feedback after the full wallet address has been copied."
    },
    "Copied address": {
      "comment": "Accessibility label after copying the full wallet address."
    },
    "Disconnect": {
      "comment": "Confirms disconnecting the wallet after the Account confirmation message."
    },
    "Disconnect wallet": {
      "comment": "Destructive Account row that opens a confirmation before disconnecting the wallet."
    },
    "Disconnect wallet?": {
      "comment": "Title of the wallet disconnection confirmation within the Account sheet."
    },
    "Keep connected": {
      "comment": "Cancels wallet disconnection and returns to the Account sheet."
    },
    "Off · Fix": {
      "comment": "Bluetooth-off status and action to open Settings in the Account sheet."
    },
    "Open Bluetooth Settings": {
      "comment": "Accessibility label for the Account Bluetooth-off recovery control."
    },
    "Organizer tools": {
      "comment": "Account navigation row opening venue operator tools."
    },
    "Sensing is paused until Bluetooth is on. Tap to open Settings.": {},
    "Venue broadcast": {},
    "Your proofs stay on this device as self-proofs. Nothing is deleted. You can connect this or another wallet anytime.": {},
    "account.wallet.header": {
      "comment": "Account sheet label naming the connected wallet provider.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet · Connected via %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
