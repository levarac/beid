        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Introduce una etiqueta para identificar este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saisissez un libellé pour identifier cet appareil."
          }
        }
      }
    },
    "That label isn't valid. Try a shorter name using regular text.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "そのラベルは無効です。もっと短い、通常の文字だけの名前にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "该标签无效。请使用更短的普通文本名称。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esa etiqueta no es válida. Prueba con un nombre más corto usando texto normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce libellé n'est pas valide. Essayez un nom plus court avec du texte normal."
          }
        }
      }
    },
    "End time must be after the start time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "終了時刻は開始時刻より後にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "结束时间必须晚于开始时间。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La hora de finalización debe ser posterior a la hora de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'heure de fin doit être postérieure à l'heure de début."
          }
        }
      }
    },
    "Join an event first, then come back to set up this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "先にイベントに参加してから、この端末を設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请先加入活动,然后再回来设置此设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Únete primero a un evento y luego vuelve para configurar este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rejoignez d'abord un événement, puis revenez configurer cet appareil."
          }
        }
      }
    },
    "History": {
      "comment": "Section header on the venue-device organizer screen: a read-only list of past assignments (label + validity period), shown below the current assignment fields.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "履歴"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "历史记录"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Historial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Historique"
          }
        }
      }
    },
    "No assignments yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "まだ割り当てがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚无分配记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no hay asignaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune attribution pour le moment."
          }
        }
      }
    },
    "venueDevice.history.assignedAt": {
      "comment": "Venue-device reassignment-history row: when this assignment was created. %@ is a pre-formatted, locale-aware date/time string.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigned %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ に割り当て"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分配于 %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Asignado el %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attribué le %@"
          }
        }
      }
    },
    "venueDevice.history.validityRange": {
      "comment": "Venue-device reassignment-history row: the assignment's validity period. %1$@ is the pre-formatted start date/time, %2$@ the end date/time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid %1$@ – %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有効期間 %1$@ – %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "有效期 %1$@ – %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Válido %1$@ – %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Valable du %1$@ au %2$@"
          }
        }
      }
    },
    "Devices mutually confirmed": {
      "comment": "Headline metric label on the Participation summary screen, paired with a count. This is the mutually-confirmed (two-way) device count for the whole session, a different and currently-always-zero metric from any all-observation device count shown elsewhere in the app (see beid#142's \"Devices sensed\"/\"Mutual confirmations\" precedent) — the reciprocity signal this depends on does not exist on-device yet, so this count is honestly 0 today, not a bug. Do not translate this as if it always grows together with a devices-sensed count, and do not substitute an estimate for it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices mutually confirmed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相互確認された端末数"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相互确认的设备数"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dispositivos confirmados mutuamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appareils confirmés mutuellement"
          }
        }
      }
    },
    "No time bands recorded for this session": {
      "comment": "Shown on the Participation summary screen instead of the time-band list when a session-aggregate snapshot exists for this proof but its band series is empty (an honest, real absence of recorded data for this session) — distinct from the screen's \"Not yet available\" state, which means no snapshot exists at all. Do not merge the wording of these two states.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time bands recorded for this session"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このセッションで記録された時間帯はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "本次记录未包含任何时段"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se registraron franjas horarias para esta sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune tranche horaire enregistrée pour cette session"
          }
        }
      }
    },
    "Participation summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participation summary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "参加記録サマリー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "参与记录摘要"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resumen de participación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Résumé de participation"
          }
        }
      }
    },
    "participationSummary.bandBuildup.row": {
      "comment": "One row in the time-band buildup list on the Participation summary screen. The first number is the band's absolute index — bands are anchored at an absolute origin, not the session start, and a band spans a fixed count of ENIN time-windows, never a duration in seconds or minutes, so do not translate it as a clock time or a duration. The second number is the distinct-device count sensed during that band, over the all-observation scope (not the mutually-confirmed scope shown in the headline metric above this list) — do not translate this as mutual/reciprocal confirmation. A gap between two consecutive rows' band index numbers means that time period was not recorded at all (for example a late arrival or a signal-loss interruption), not that it recorded zero devices — never phrase this row or the list around it as if every band number appears.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band %1$lld: %2$lld devices sensed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "バンド %1$lld: 検知端末 %2$lld 台"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "时段 %1$lld：检测到 %2$lld 台设备"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Banda %1$lld: %2$lld dispositivos detectados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bande %1$lld : %2$lld appareils détectés"
          }
        }
      }
    },
    "participationSummary.notYetAvailable": {
      "comment": "Status shown on the Participation summary screen when no session-aggregate snapshot was ever persisted for this proof: the session ended before the snapshot-writing feature existed, the write failed (best-effort, can fail silently), or the session never reached the recording phase at all. This means the data was never captured, not that an attempt was made and failed — do not translate as an error, warning, or declined state, and do not confuse it with a real, present value of zero (this screen's headline metric can legitimately show a real 0, which is a different, available state).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "未対応"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "尚不可用"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aún no disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas encore disponible"
          }
        }
      }
    },
    "Time-band buildup": {
      "comment": "Section label on the Participation summary screen, above a list of time-band rows. Each row below this label covers a fixed span of ENIN time-windows, not a fixed duration in seconds or minutes. A gap in the list (a band index that does not appear) means that time period was not recorded at all — for example the participant arrived late or had a signal-loss interruption — never that it recorded zero devices; do not phrase this heading as if the list shows every time period end to end.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time-band buildup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "時間帯ごとの積み上がり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "分时段汇总"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acumulación por franjas horarias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cumul par tranches horaires"
          }
        }
      }
    },
    "View participation summary": {
      "comment": "Row label on Proof Detail linking to the Participation summary screen, which shows a post-session summary (mutually-confirmed device count and a time-band buildup) for this proof's recording session.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View participation summary"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "参加記録サマリーを見る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
