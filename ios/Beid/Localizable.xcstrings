    "Private by design": {},
    "Proof": {},
    "Proof Collected": {},
    "Proof Detail": {},
    "Prove you were there. Automatically.": {},
    "Scan": {
      "comment": "Screen title for the scan/sensing flow's modal header (noun, the name of the flow, not an instruction to scan something)."
    },
    "Sense Event": {},
    "Sensing": {},
    "Sensing automatically": {},
    "Sensing paused": {
