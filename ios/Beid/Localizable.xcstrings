{
  "sourceLanguage": "en",
  "strings": {
    "home.header.counts": {
      "comment": "Collection Home header: independently pluralized distinct event count, including the active event, and total stored Proof record count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@events@ · %#@proofs@"
          },
          "substitutions": {
            "events": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg event"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg events"
                    }
                  }
                }
              }
            },
            "proofs": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg proof"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg proofs"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "home.account.accessibilityLabel": {
      "comment": "VoiceOver label for the Collection Home account control. The argument is a shortened wallet address or the localized Account title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account, %@"
          }
        }
      }
    },
    "home.account.title": {
      "comment": "Collection Home account control when no wallet address is available; opens the account sheet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account"
          }
        }
      }
    },
    "home.active.metrics": {
      "comment": "Live active event metrics: mutual device count from SessionAggregate and current sensing window count. Zero mutual is a valid current outcome.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld mutual · window %2$lld"
          }
        }
      }
    },
    "home.active.metrics.accessibilityLabel": {
      "comment": "VoiceOver expansion of the active event metrics: mutual and detected are distinct live counts; window is the sensing window count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld mutual, %2$lld detected, window %3$lld"
          }
        }
      }
    },
    "home.past.sessionCaption": {
      "comment": "Past event row: latest session date followed by the independently pluralized number of stored sessions in this event group.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %#@sessions@"
          },
          "substitutions": {
            "sessions": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg session"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg sessions"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "home.past.proofAction": {
      "comment": "Trailing past event action. Count is stored Proof records in the event group; arrow means open its newest proof detail.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld proof →"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld proofs →"
                }
              }
            }
          }
        }
      }
    },
    "home.past.accessibilityLabel": {
      "comment": "VoiceOver label for a past event row. First argument is the operator-supplied event name; second is the number of stored Proof records.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %#@proofs@, open event"
          },
          "substitutions": {
            "proofs": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg proof"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg proofs"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "home.clock.networkInstructions.title": {
      "comment": "Home clock help title when beid could not compare the device clock with network time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection"
          }
        }
      }
    },
    "home.clock.timeInstructions.title": {
      "comment": "Home clock help title when network comparison found the device clock outside tolerance.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the time automatically"
          }
        }
      }
    },
    "home.scan.action": {
      "comment": "Primary Collection Home action: verb meaning start sensing nearby events, distinct from the Scan screen title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan"
          }
        }
      }
    },
    "home.empty.description": {
      "comment": "Collection Home empty-state explanation. The English line break after show up matches the two-line design; other locales may wrap as needed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk into an event — it will show up\nhere automatically."
          }
        }
      }
    },
    "Events": {
      "comment": "Title of the Collection Home screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events"
          }
        }
      }
    },
    "NOW · SENSING": {
      "comment": "Eyebrow on the active event card, meaning sensing is currently running.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NOW · SENSING"
          }
        }
      }
    },
    "OPEN": {
      "comment": "Action on the active event card; returns to the live sensing screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OPEN"
          }
        }
      }
    },
    "Open sensing event": {
      "comment": "VoiceOver description of the arrow on the active event OPEN action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open sensing event"
          }
        }
      }
    },
    "PAST": {
      "comment": "Section title for previously finalized events on Collection Home.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PAST"
          }
        }
      }
    },
    "NO EVENTS YET": {
      "comment": "Heading in Collection Home empty state when no event has been sensed or stored.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NO EVENTS YET"
          }
        }
      }
    },
    "ENTER EVENT CODE": {
      "comment": "Collection Home empty-state action to join an event by entering its code.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ENTER EVENT CODE"
          }
        }
      }
    },
    "Enter event code": {
      "comment": "VoiceOver description of the arrow on the event-code action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter event code"
          }
        }
      }
    },
    "CLOCK OUT OF SYNC": {
      "comment": "Home clock warning when the preflight comparison exceeds the allowed time tolerance.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLOCK OUT OF SYNC"
          }
        }
      }
    },
    "CLOCK CHECK UNAVAILABLE": {
      "comment": "Home clock warning when the preflight comparison could not determine clock accuracy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLOCK CHECK UNAVAILABLE"
          }
        }
      }
    },
    "Proofs need an accurate clock. Turn on “Set automatically” in Settings.": {
      "comment": "Body of the Home clock warning after an over-tolerance verdict.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proofs need an accurate clock. Turn on “Set automatically” in Settings."
          }
        }
      }
    },
    "beid couldn't compare the clock with the network. Check your connection, then try again.": {
      "comment": "Body of the Home clock warning after an undeterminable verdict.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "beid couldn't compare the clock with the network. Check your connection, then try again."
          }
        }
      }
    },
    "FIX": {
      "comment": "Action on the Home clock warning; opens instructions and a Check again control.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FIX"
          }
        }
      }
    },
    "Clock help": {
      "comment": "VoiceOver description of the arrow on the Home clock FIX action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock help"
          }
        }
      }
    },
    "Connect to the network, then check the clock again before joining an event.": {
      "comment": "Home clock help instructions after the clock comparison was undeterminable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the network, then check the clock again before joining an event."
          }
        }
      }
    },
    "Open Settings, choose General, then Date & Time, and turn on Set Automatically.": {
      "comment": "Home clock help instructions after an over-tolerance verdict; the app cannot deep-link to Date & Time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings, choose General, then Date & Time, and turn on Set Automatically."
          }
        }
      }
    },
    "Sensing continues in background": {
      "comment": "Status on Collection Home while sensing continues after the Scan screen closes.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensing continues in background"
          }
        }
      }
    },
    "Stop sensing": {
      "comment": "Collection Home action that stops the active sensing session.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop sensing"
          }
        }
      }
    },
    "%lld": {},
    "Account": {},
    "Active": {
      "comment": "Generic on/off status label shown next to a colored dot — used for the Bluetooth power state (Account sheet) and for the currently-broadcasting entry in the venue-device reassignment history (gh#138)."
    },
    "Added to your collection.": {},
    "Address": {},
    "Allow Bluetooth": {},
    "Approve the connection in MetaMask": {
      "comment": "Instruction shown while beid waits for the user to approve the direct connection in the MetaMask app."
    },
    "Ask the event organizer for the code. This joins the event directly, without connecting a wallet.": {},
    "Automatic": {},
    "Bluetooth": {},
    "Bluetooth is off": {},
    "Cancel": {
      "comment": "Dismisses the Home event-code entry sheet without joining an event. Also used for other cancellation actions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      }
    },
    "Close": {
      "comment": "Dismisses the current screen without taking further action. Used as the accessibility label for the scan flow's toolbar close (X) button, and as the button on the wallet-binding failure sheet when trying again cannot help (an unsupported smart-contract wallet).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "Connect Wallet": {},
    "Connect Your Wallet": {},
    "Connect wallet instead": {},
    "Connect with MetaMask": {
      "comment": "Button: starts a direct app-to-app connection with the MetaMask app."
    },
    "Connected": {},
    "Connecting to wallet…": {},
    "Connection failed": {},
    "Copy": {
      "comment": "Button on the Account sheet: copies the connected wallet address to the clipboard. Verb, not a noun or a generic duplicate action.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        }
      }
    },
    "Copy URI": {},
    "Copy address": {
      "comment": "Button: copies the connected wallet address to the clipboard, not a noun."
    },
    "Detected event": {},
    "No event is registered for that code. Check it with the event organizer.": {},
    "Some nearby events are not shown.": {},
    "That code didn't match the event beid found. Check that you have the whole code.": {},
    "That event isn't open to join right now.": {},
    "beid couldn't verify that event. Check the code with the event organizer.": {},
    "beid needs a connection to verify this event, and couldn't reach the network. Check your connection and try again.": {},
    "beid can't trust event times while the clock is wrong. Turn on automatic date and time in Settings, then check again.": {},
    "beid couldn't compare the clock with the network, so event times can't be trusted yet. Check your connection, then try again.": {},
    "Check again": {
      "comment": "Re-runs the clock preflight comparison after the user follows the clock help instructions.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        }
      }
    },
    "Couldn't check this device's clock": {},
    "This device's clock is off": {},
    "demo.scenario.longDisplayNames.eventName": {
      "comment": "Long fictional event name used only in the Debug demo scenario to verify wrapping and hierarchy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The International Gathering for Open, Verifiable and Durable Local Participation"
          }
        }
      }
    },
    "demo.scenario.longDisplayNames.venue": {
      "comment": "Long fictional venue name used only in the Debug demo scenario to verify wrapping and hierarchy.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The East Exhibition Hall at the Tokyo International Convention and Community Center"
          }
        }
      }
    },
    "detail.devicesSensed.label": {
      "comment": "Metric row label on Proof Detail and Signal Lost, paired with a number. \"Devices\", not people: it counts distinct nearby devices sensed during the event, each counted once however long it stayed. Does not imply mutual or reciprocal confirmation — this device cannot tell whether a peer also observed it back. Use your language's word for a phone or handset, not a word for a person or a peer.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices sensed"
          }
        }
      }
    },
    "Disconnect Wallet": {},
    "Done": {},
    "Enable Bluetooth": {},
    "Enter Event Code": {},
    "Enter an event code to continue. Ask the event organizer for it.": {},
    "Enter event code instead": {},
    "ETHGlobal Tokyo": {
      "comment": "Event name shown on the demo event card. A real conference name used as sample data in DemoEvent mode, which is also the App Review demo path — translate it the way that conference is referred to in the target language, or leave it as-is if it is normally written in Latin script.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ETHGlobal Tokyo"
          }
        }
      }
    },
    "Event Found": {},
    "event.identityVerification.checking": {
      "comment": "Status row beneath a live event card while the app checks the event registry. Sentence case. Do not add an event name; this row reports status only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking event registry…"
          }
        }
      }
    },
    "event.identityVerification.notFound": {
      "comment": "Neutral terminal status row when the registry has no definition for the detected event. Sentence case. Do not add an event name or imply that the event is invalid.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No registry definition was found for this event."
          }
        }
      }
    },
    "event.identityVerification.retry": {
      "comment": "Accessible button label for manually retrying an unavailable or no-definition event registry lookup. Sentence case. This is the only retry affordance in the row.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry event registry verification"
          }
        }
      }
    },
    "event.identityVerification.unavailable": {
      "comment": "Neutral terminal status row when the event registry could not be reached or returned malformed data. Sentence case. Do not add an event name or imply a verification result.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event registry is temporarily unavailable."
          }
        }
      }
    },
    "event.identityVerification.verified": {
      "comment": "Success status row after the registry returned a valid verified event context. Sentence case. Report identity status only; never include the event display name in this row.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event identity verified"
          }
        }
      }
    },
    "Event code": {
      "comment": "Label for the text field where the user types the alphanumeric code for the event they want to join."
    },
    "Events find you": {},
    "Get MetaMask": {
      "comment": "Button: opens the App Store page for MetaMask."
    },
    "Get Started": {},
    "I've turned it on": {},
    "Install MetaMask to connect directly.": {},
    "Join Event": {},
    "Keep beid open nearby to collect proof of attendance.": {},
    "MetaMask is not installed": {},
    "Method": {},
    "My Proofs": {},
    "Nearby events": {},
    "Nearby events appear automatically — no codes, no search.": {},
    "Nearby peers are confirming your attendance automatically.": {},
    "nearbyEvent.beaconName.conflict": {
      "comment": "Warning shown when nearby beacons announce different names for the same event-code hash. Do not choose one of the names as authoritative.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple names reported nearby"
          }
        }
      }
    },
    "nearbyEvent.beaconName.label": {
      "comment": "Label above an event name received from a nearby Bluetooth beacon. The name is an untrusted announcement, not a verified event identity.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name announced by nearby beacon"
          }
        }
      }
    },
    "nearbyEvent.beaconName.missing": {
      "comment": "Fallback shown when a nearby Bluetooth candidate has no display name. The candidate remains visible.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No name announced by nearby beacon"
          }
        }
      }
    },
    "nearbyEvent.manualEntry.button": {
      "comment": "Secondary action on the nearby-event scan screen that opens manual event-code entry when discovery does not find the user's event.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter event code"
          }
        }
      }
    },
    "nearbyEvent.searching.rescue": {
      "comment": "Guidance below the empty nearby-event list; the manual code-entry button is directly below this content.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If no event appears, enter the event code instead."
          }
        }
      }
    },
    "nearbyEvent.searching.title": {
      "comment": "Status shown while the pre-join Bluetooth scan has not found any nearby event candidates.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching for nearby events…"
          }
        }
      }
    },
    "nearbyEvent.selected": {
      "comment": "Display-only status on the sole currently joinable nearby-event card. The user must still tap the card to join.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        }
      }
    },
    "nearbyEvent.validityPeriod": {
      "comment": "Display-only validity period on a verified nearby-event card. The first value is the start date and time; the second is the end date and time. It never authorizes a join.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid %1$@ – %2$@"
          }
        }
      }
    },
    "nearbyEvent.verification.verified": {
      "comment": "Status on an interactive nearby-event card whose registry evidence currently permits a join. This is separate from the display-only Selected state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified"
          }
        }
      }
    },
    "nearbyEvent.verification.waiting": {
      "comment": "Non-interactive nearby-event card status: registry evidence is not currently sufficient to join this candidate.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for event verification"
          }
        }
      }
    },
    "No proofs yet": {},
    "Not signed": {},
    "Off": {
      "comment": "Status label shown next to a colored dot when Bluetooth is powered off."
    },
    "On": {},
    "On-device first": {},
    "Only anonymous proofs are exchanged, never your identity.": {},
    "ownerKeyRestoration.dismiss": {
      "comment": "Button that closes an owner-key restoration warning after the user has read it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close warning"
          }
        }
      }
    },
    "ownerKeyRestoration.identityReset.message": {
      "comment": "Alert message explaining that an unreadable proof-signing identity was replaced and the previous identity is no longer usable on this device.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "beid could not restore the identity this device used to sign proofs, so it created a new one. This device can no longer use the previous identity."
          }
        }
      }
    },
    "ownerKeyRestoration.identityReset.title": {
      "comment": "Alert title shown when beid could not restore the device identity used to sign proofs and created a new one.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof identity was reset"
          }
        }
      }
    },
    "ownerKeyRestoration.identityResetWithRecords.message": {
      "comment": "Alert message explaining both the replacement of an unreadable proof-signing identity and the effect on saved proof-related records.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "beid created a new identity because the saved one could not be restored. Some saved proof records still refer to the previous identity; they still exist, but this device can no longer sign as that identity."
          }
        }
      }
    },
    "ownerKeyRestoration.identityResetWithRecords.title": {
      "comment": "Alert title shown when beid both replaced an unreadable proof-signing identity and found saved records that use the previous identity.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof identity could not be restored"
          }
        }
      }
    },
    "ownerKeyRestoration.savedRecordsMismatch.message": {
      "comment": "Alert message explaining that saved proof-related records remain on disk but refer to an owner identity this device no longer controls.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some saved proof records were created with a different identity. They still exist, but this device can no longer sign as that identity."
          }
        }
      }
    },
    "ownerKeyRestoration.savedRecordsMismatch.title": {
      "comment": "Alert title shown when saved proof-related records refer to an owner identity different from the device's current identity.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some proof records use a previous identity"
          }
        }
      }
    },
