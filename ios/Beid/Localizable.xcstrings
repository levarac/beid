            "value": "beid 无法连接到您的钱包。请检查您的网络连接后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid no pudo conectarse a tu cartera. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid n'a pas pu se connecter à votre portefeuille. Vérifiez votre connexion et réessayez."
          }
        }
      }
    },
    "beid couldn't join that event. Check the code and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid no pudo unirse a ese evento. Comprueba el código e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
