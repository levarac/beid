          "stringUnit": {
            "state": "translated",
            "value": "Connected via %@"
          }
        }
      }
    },
    "beid": {
      "comment": "Brand name, appears as the app title on the Welcome screen. Not translated in any target locale."
    },
    "beid can't sense events or collect proofs while Bluetooth is off.": {},
    "beid couldn't connect to your wallet. Check your connection and try again.": {},
    "beid couldn't join that event. Check the code and try again.": {},
    "beid found a nearby event signal.": {},
    "beid lost the connection to %@. Move closer and we'll pick it back up automatically.": {},
    "beid senses nearby events and people over Bluetooth Low Energy — that's how it proves you were really there.": {},
    "beid uses your wallet to sign proofs of event attendance.": {},
    "e.g. ETHTOKYO2026": {
      "comment": "Placeholder shown in the empty event-code text field. Keep the invented example code (ETHTOKYO2026) as-is; translate only the localized equivalent of \"e.g.\"."
    },
    "Collection": {
      "comment": "Noun: title of the Collection Home screen, showing the user's collected proofs."
    },
    "collection.eventCount": {
      "comment": "Caption above the Collection Home grid: count of distinct events the user has collected a proof for (grouped by eventCode; each proof recorded before eventCode existed counts as its own event). \"Proof\" here is the mass-noun collected fact, per DESIGN.md §15’s vocabulary (a proof is collected — the object of \"collect\" is proof, never the event itself), and the number scopes how many events that applies across; it is not a raw count of recording sessions — a user who scanned the same event twice still counts as one event here, and this caption does not imply exactly one Proof record per event.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Proof collected from %lld event"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Proof collected from %lld events"
                }
              }
            }
          }
        }
      }
    },
    "collection.proofCount": {
      "comment": "Caption above the Collection Home grid, showing how many proofs the user has collected so far.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld proof collected"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld proofs collected"
                }
              }
            }
          }
        }
      }
    },
    "Start sensing at an event to collect your first proof.": {},
    "proofCard.sessionCount": {
      "comment": "Caption on a Collection Home card for an event recorded more than once (the user re-scanned the same event in a separate app session). Count of distinct recorded sessions for this event, not devices or peers. Also reused, composed after a comma, inside proofCard.accessibilityLabel's VoiceOver text for the same fact when sessionCount > 1.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld session"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sessions"
                }
              }
            }
          }
        }
      }
    },
    "proofCard.accessibilityLabel": {
      "comment": "VoiceOver label for one proof card in the Collection Home grid — composed from the event name and collection date. When the event was recorded in more than one session, proofCard.sessionCount's own text (e.g. \"3 sessions\") is appended after a comma, so VoiceOver users get the same session-count fact sighted users see in the card's secondary caption.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proof of %1$@, %2$@"
          }
        }
      }
    },
    "Connect a wallet to seal your attendance to this event.": {},
    "Seal with connected wallet": {},
    "Sealed": {},
    "Couldn't seal attendance": {},
    "beid couldn't finish sealing your attendance with this wallet.": {},
    "scan.binding.title": {
      "comment": "Event name, e.g. 'ETH Tokyo 2026 confirmed' — heading on the wallet connect+binding prompt.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ confirmed"
          }
        }
      }
    },
    "scan.binding.sealedSubtitle": {
      "comment": "Confirmation after the wallet-binding signature succeeds; event name is interpolated, e.g. 'Your attendance to ETH Tokyo 2026 is sealed.'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your attendance to %@ is sealed."
          }
        }
      }
    },
    "scan.binding.declined": {
      "comment": "Reason shown when the user's wallet app declines the binding signature request.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined in wallet"
          }
        }
      }
    },
    "scan.binding.notConnected": {
      "comment": "Reason shown when the binding signature request has no connected wallet session to use.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet not connected"
          }
        }
      }
    },
    "scan.binding.timedOut": {
      "comment": "Reason shown when the wallet app never responds to the binding signature request within the timeout.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet did not respond in time"
          }
        }
      }
    },
    "DETECTED": {
      "comment": "Status badge on the event card during BLE sensing, not audio/video recording."
    },
    "RECORDING": {
      "comment": "Status badge on the event card during BLE sensing, not audio/video recording."
    },
    "PAUSED": {
      "comment": "Status badge on the event card during BLE sensing, not audio/video recording."
    },
    "Verification starts automatically — stay nearby": {},
    "scan.recording.caption": {
      "comment": "Cumulative count of distinct nearby devices sensed at the event, each counted once however long it stayed; no fixed target. Do NOT translate this as mutual, two-way, or reciprocal confirmation: this device cannot tell whether a peer also observed it, so any such wording would overclaim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording your attendance automatically · %lld devices sensed"
          }
        }
      }
    },
    "scan.recording.diagnosticCaption": {
      "comment": "Temporary diagnostic line on the Recording screen (beid#218, DECISIONS 2026-08-20) — not permanent product UI, does not need to survive #141's rebuild, but ships to real TestFlight/production builds (not #if DEBUG) because a live multi-device field test needs to read these counters without a debugger attached. \"Identified\" is SensingCoordinator.devicesVerified: distinct nearby devices whose proximity identifier (RPID) was resolved to a display ID. \"Unidentified\" is SensingCoordinator.unidentifiedRpidCount: proximity identifiers observed but not yet resolved to a display ID — radio is arriving, but the device could not be identified. A large unidentified count with a flat identified count points at an identification failure; both flat points at nothing arriving at all — opposite fixes, which is why both numbers must be visible together. Do NOT translate this as mutual, two-way, or reciprocal confirmation of any kind — neither number says anything about whether a peer observed this device back (the protocol carries no such signal, DECISIONS 2026-08-09). Same bar as this file's `scan.recording.caption` translator comment on the line above this one.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics: %1$lld identified · %2$lld unidentified"
          }
        }
      }
    },
    "Transparency": {
      "comment": "Screen title (also reused as the ItemDetailView row label linking to this screen): the name of the screen showing a participant the status of their own data (recorded/sent/published/verified). Noun referring to open, checkable data status, not visual/window transparency or opacity.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparency"
          }
        }
      }
    },
    "Participation": {
      "comment": "Tier 1 of 3 on the Transparency screen: whether this device has joined the event at all. Distinct from the \"Participation record\" tier below it, which is about what has happened to the data after joining (stored/sent/published), not about the join action itself.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participation"
          }
        }
      }
    },
    "Joined": {
      "comment": "Value shown under the \"Participation\" tier: whether this device has joined the event. \"Joined\" here means the join action was taken, not a social/group-membership sense of the word.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined"
          }
        }
      }
    },
    "Not joined": {
      "comment": "Value shown under the \"Participation\" tier: whether this device has joined the event. \"Joined\" here means the join action was taken, not a social/group-membership sense of the word.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not joined"
          }
        }
      }
    },
    "Participation record": {
      "comment": "Tier 2 of 3 on the Transparency screen: what has happened to this device's sensing data after joining (recorded on-device / sent to a report server / included in published data). Distinct from \"Verified proof\" below it, which is about third-party verification, not data handling.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participation record"
          }
        }
      }
    },
    "Sent": {
      "comment": "Sub-state row under \"Participation record\": whether this device's sensing data has been transmitted to a report server. Always shows \"Not yet available\" today (see the adjacent status text) because no report-submission code exists in the app yet — this is not a failed-send state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent"
          }
        }
      }
    },
    "Included in published data": {
      "comment": "Sub-state row under \"Participation record\": whether this device's data has been incorporated into the report server's published dataset. Always shows \"Not yet available\" today because no report server or publishing pipeline exists yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Included in published data"
          }
        }
      }
    },
    "Verified proof": {
      "comment": "Tier 3 of 3 on the Transparency screen: whether this device's participation has passed third-party verification (a status that would include a pending sub-state once it exists). Always shows \"Not yet available\" today because no verifier exists yet in the product. Distinct from the existing, always-true \"Verified\" status shown on the Proof Detail screen, which is about local BLE self-evidence, not third-party verification.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified proof"
          }
        }
      }
    },
    "transparency.notYetAvailable": {
      "comment": "Status for a participation-record or verified-proof row whose data source doesn't exist in the product yet (no report submission or verifier is implemented). This means the capability itself is not built yet, not that an attempt was made and failed — do not translate as an error, warning, or declined state.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet available"
          }
        }
      }
    },
    "scan.recording.mutualCount": {
      "comment": "Count of mutually-confirmed (two-way) observations — a distinct metric from the devices-sensed count in the line above it, not a synonym or a related total. This currently always displays as 0 because the on-device protocol has no way to detect when a nearby device also observed this device back; establishing that is a separate, later, off-device verification step. Do not translate this as if it always grows together with the devices-sensed count, and do not omit it or fold it into that line.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutual confirmations: %lld"
          }
        }
      }
    },
    "scan.recording.windowBuildup": {
      "comment": "Count of ENIN time-windows recorded for this session so far, shown as a simple running total. This is a coverage/buildup indicator, not a device or confirmation count — a window is \"recorded\" once its time interval has been observed and closed, independent of how many devices were present in it.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld window recorded"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld windows recorded"
                }
              }
            }
          }
        }
      }
    },
    "Venue Device": {},
    "Assignment": {
      "comment": "Section header on the venue-device organizer screen (gh#138) for the label + validity-period fields — not a task/homework assignment."
    },
    "Label": {
      "comment": "Text field on the venue-device organizer screen: the display name this device broadcasts to nearby attendees (Barnard B005 eventDisplayName), not a generic UI label element."
    },
    "Leave Event": {},
    "e.g. Doorway A": {
      "comment": "Placeholder example shown inside the empty venue-device label field."
    },
    "Starts": {
      "comment": "Label for the validity-period start date/time picker on the venue-device organizer screen, not a verb describing an event beginning."
    },
    "Ends": {
      "comment": "Label for the validity-period end date/time picker on the venue-device organizer screen."
    },
    "Beid does not verify this broadcast. Anyone nearby with the app can see the name you set here.": {
      "comment": "Organizer-facing trust disclaimer shown under the label field on the venue-device screen (PM-approved exact copy, docs/specs/participation-surface.md §3.2 — do not edit without new sign-off). \"This broadcast\" refers to the Bluetooth broadcast this screen's toggle turns on, not the app itself. \"The name you set here\" refers to the Label field on this same screen."
    },
    "Enter a label to identify this device.": {},
    "That label isn't valid. Try a shorter name using regular text.": {},
    "End time must be after the start time.": {},
    "Join an event first, then come back to set up this device.": {},
    "History": {
      "comment": "Section header on the venue-device organizer screen: a read-only list of past assignments (label + validity period), shown below the current assignment fields."
    },
    "No assignments yet.": {},
    "venueDevice.history.assignedAt": {
      "comment": "Venue-device reassignment-history row: when this assignment was created. %@ is a pre-formatted, locale-aware date/time string.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigned %@"
          }
        }
      }
    },
    "venueDevice.history.validityRange": {
      "comment": "Venue-device reassignment-history row: the assignment's validity period. %1$@ is the pre-formatted start date/time, %2$@ the end date/time.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid %1$@ – %2$@"
          }
        }
      }
    },
    "Devices mutually confirmed": {
      "comment": "Headline metric label on the Participation summary screen, paired with a value. This is the mutually-confirmed (two-way) device count for the whole session, a different metric from any all-observation device count shown elsewhere in the app (see beid#142's \"Devices sensed\"/\"Mutual confirmations\" precedent) — the reciprocity signal this depends on does not exist on-device yet, so this metric never shows a numeric value: the value shown next to this label is always a \"cannot be determined on this device\" state (see `participationSummary.mutualCount.unavailable`), never a number including 0. Do not translate this as if it always grows together with a devices-sensed count, and do not substitute an estimate for it.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices mutually confirmed"
          }
        }
      }
    },
    "No time bands recorded for this session": {
      "comment": "Shown on the Participation summary screen instead of the time-band list when a session-aggregate snapshot exists for this proof but its band series is empty (an honest, real absence of recorded data for this session) — distinct from the screen's \"Not yet available\" state, which means no snapshot exists at all. Do not merge the wording of these two states.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time bands recorded for this session"
          }
        }
      }
    },
    "Participation summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Participation summary"
          }
        }
      }
    },
    "participationSummary.bandBuildup.row": {
      "comment": "One row in the time-band buildup list on the Participation summary screen. The first number is the band's absolute index — bands are anchored at an absolute origin, not the session start, and a band spans a fixed count of ENIN time-windows, never a duration in seconds or minutes, so do not translate it as a clock time or a duration. The second number is the distinct-device count sensed during that band, over the all-observation scope (not the mutually-confirmed scope shown in the headline metric above this list) — do not translate this as mutual/reciprocal confirmation. A gap between two consecutive rows' band index numbers means that time period was not recorded at all (for example a late arrival or a signal-loss interruption), not that it recorded zero devices — never phrase this row or the list around it as if every band number appears.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Band %1$lld: %2$lld devices sensed"
          }
        }
      }
    },
    "participationSummary.sessionList.header": {
      "comment": "Header above the per-session list on the Participation summary screen for an event recorded more than once. Count of distinct recording sessions for this event, not devices.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld session recorded for this event"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld sessions recorded for this event"
                }
              }
            }
          }
        }
      }
    },
    "participationSummary.sessionList.row.mutualCount": {
      "comment": "Trailing value on one row of the per-session list on the Participation summary screen: the mutually-confirmed device count for that one specific session, matching the scope of the headline metric shown on the single-session Participation summary screen. Not a duration, not an index, not the event-wide Transparency count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld confirmed"
          }
        }
      }
    },
    "participationSummary.mutualCount.unavailable": {
      "comment": "Value shown for the \"Devices mutually confirmed\" headline metric on the Participation summary screen — unconditionally, regardless of whether a session-aggregate snapshot exists for this proof. The mutual (two-way) device count cannot be measured on this device at all: the protocol only reports \"this device observed a peer,\" never \"the peer observed this device back,\" so establishing mutual confirmation requires reconciling two devices' signed records off-device (beid#144 stage 4, not yet built). This is a different, narrower reason than this screen's other \"Not yet available\" text (`participationSummary.notYetAvailable`, used when no session data was captured at all) — do not merge the two keys, and do not translate this as an error, warning, or declined state. Never show a numeric value (including 0) for this metric; DECISIONS 2026-08-20 (beid#222) settled that an honest-but-unmeasured 0 was read on real hardware as \"measured and got 0,\" which is misinformation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet available"
          }
        }
      }
    },
    "participationSummary.notYetAvailable": {
      "comment": "Status shown on the Participation summary screen when no session-aggregate snapshot was ever persisted for this proof: the session ended before the snapshot-writing feature existed, the write failed (best-effort, can fail silently), or the session never reached the recording phase at all. This means the data was never captured, not that an attempt was made and failed — do not translate as an error, warning, or declined state. Never confuse this key with `participationSummary.mutualCount.unavailable`, the headline metric's own \"not yet available\" text — a different, narrower reason (mutual confirmation is structurally unmeasurable on-device, not merely uncaptured).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet available"
          }
        }
      }
    },
    "Time-band buildup": {
      "comment": "Section label on the Participation summary screen, above a list of time-band rows. Each row below this label covers a fixed span of ENIN time-windows, not a fixed duration in seconds or minutes. A gap in the list (a band index that does not appear) means that time period was not recorded at all — for example the participant arrived late or had a signal-loss interruption — never that it recorded zero devices; do not phrase this heading as if the list shows every time period end to end.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time-band buildup"
          }
        }
      }
    },
    "View participation summary": {
      "comment": "Row label on Proof Detail linking to the Participation summary screen, which shows a post-session summary (mutually-confirmed device count and a time-band buildup) for this proof's recording session.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View participation summary"
          }
        }
      }
    },
    "Current": {
      "comment": "Trailing label on a Past Events row identifying the event this device is presently joined to. Refers to \"the event currently joined,\" not a generic adjective — distinct from any other use of the English word \"Current\" elsewhere in the app."
    },
    "No past events yet.": {
      "comment": "Empty state on the Past Events screen, shown when this device has never recorded a Proof for any event."
    },
    "Only events you've actually recorded a proof for are listed here.": {
      "comment": "Footer under the Past Events list, clarifying that a code that was typed and abandoned before recording completed does not appear."
    },
    "account.pastEvents.label": {
      "comment": "Menu row in the Account sheet that opens the list of previously joined events (beid#230), for rejoining one without retyping its code.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past Events"
          }
        }
      }
    }
  },
  "version": "1.0"
}
