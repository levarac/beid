        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ver resumen de participación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voir le résumé de participation"
          }
        }
      }
    }
  },
