{
  "sourceLanguage": "en",
  "strings": {
    "Ask the event organizer for the code. This joins the event directly, without connecting a wallet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pide el código al organizador del evento. Esto te une al evento directamente, sin conectar una billetera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Demandez le code à l'organisateur de l'événement. Cela vous permet de rejoindre l'événement directement, sans connecter de portefeuille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "イベントコードは主催者に確認してください。ウォレットを接続せずに、直接イベントに参加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "向活动主办方索取代码。这样可以直接加入活动，无需连接钱包。"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automático"
          }
        },
        "fr": {
