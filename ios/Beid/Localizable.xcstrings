    },
    "beid couldn't connect to your wallet. Check your connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid はウォレットに接続できませんでした。接続状況を確認してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
