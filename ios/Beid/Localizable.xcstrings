    },
    "beid can't sense events or collect proofs while Bluetooth is off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid no puede detectar eventos ni recopilar pruebas mientras el Bluetooth esté desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid ne peut pas détecter d'événements ni collecter de preuves tant que le Bluetooth est désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bluetoothがオフの間、beidはイベントを検知したり証明を収集したりできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "蓝牙关闭时,beid 无法感知活动或收集证明。"
          }
        }
      }
    },
    "beid couldn't connect to your wallet. Check your connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid はウォレットに接続できませんでした。接続状況を確認してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid 无法连接到您的钱包。请检查您的网络连接后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid no pudo conectarse a tu cartera. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid n'a pas pu se connecter à votre portefeuille. Vérifiez votre connexion et réessayez."
          }
        }
      }
    },
    "beid couldn't join that event. Check the code and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid no pudo unirse a ese evento. Comprueba el código e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid n'a pas pu rejoindre cet événement. Vérifiez le code et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beidはそのイベントに参加できませんでした。コードを確認してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid 无法加入该活动。请检查代码后重试。"
          }
        }
      }
    },
    "beid found a nearby event signal.": {},
    "beid lost the connection to %@. Move closer and we'll pick it back up automatically.": {},
    "beid needs a Reown Cloud project ID to connect a wallet. Copy ios/Secrets.example.plist to ios/Beid/Secrets.plist and fill in PROJECT_ID from dashboard.reown.com.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウォレットを接続するには Reown Cloud のプロジェクト ID が必要です。ios/Secrets.example.plist を ios/Beid/Secrets.plist にコピーし、dashboard.reown.com で取得した PROJECT_ID を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "连接钱包需要 Reown Cloud 项目 ID。请将 ios/Secrets.example.plist 复制为 ios/Beid/Secrets.plist，并填写从 dashboard.reown.com 获取的 PROJECT_ID。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid necesita un ID de proyecto de Reown Cloud para conectar una cartera. Copia ios/Secrets.example.plist a ios/Beid/Secrets.plist y completa PROJECT_ID desde dashboard.reown.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid a besoin d'un ID de projet Reown Cloud pour connecter un portefeuille. Copiez ios/Secrets.example.plist vers ios/Beid/Secrets.plist et renseignez PROJECT_ID depuis dashboard.reown.com."
          }
        }
      }
    },
    "beid senses nearby events and people over Bluetooth Low Energy — that's how it proves you were really there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid detecta eventos y personas cercanas mediante Bluetooth de baja energía; así es como demuestra que realmente estuviste allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid détecte les événements et les personnes à proximité via le Bluetooth basse consommation — c'est ainsi qu'il prouve que vous étiez vraiment présent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beidはBluetooth Low Energyを通じて近くのイベントや人を検知します — こうしてあなたが本当にそこにいたことを証明します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid 通过低功耗蓝牙(BLE)感知附近的活动和人群 — 这就是它证明你确实到场的方式。"
          }
        }
      }
    },
    "beid uses your wallet to sign proofs of event attendance.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid はイベント参加証明への署名にあなたのウォレットを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid 使用您的钱包为活动出席证明签名。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid usa tu cartera para firmar las pruebas de asistencia a eventos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "beid utilise votre portefeuille pour signer les preuves de participation aux événements."
          }
        }
      }
    },
