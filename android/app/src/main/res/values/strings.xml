<resources>
    <string name="app_name">beid</string>

    <!-- Screen 01: Welcome (mirrors iOS's WelcomeView). -->
    <string name="welcome_title">beid</string>
    <string name="welcome_subtitle">Prove you were there. Automatically.</string>
    <string name="welcome_get_started">Get Started</string>

    <!-- Screen 02: Bluetooth-permission explanation (mirrors iOS's BluetoothPermissionView). -->
    <string name="bluetooth_permission_title">Enable Bluetooth</string>
    <string name="bluetooth_permission_subtitle">beid senses nearby events and people over Bluetooth Low Energy — that\'s how it proves you were really there.</string>
    <string name="bluetooth_permission_bullet_events_find_you_title">Events find you</string>
    <string name="bluetooth_permission_bullet_events_find_you_subtitle">Nearby events appear automatically — no codes, no search.</string>
    <string name="bluetooth_permission_bullet_private_title">Private by design</string>
    <string name="bluetooth_permission_bullet_private_subtitle">Only anonymous proofs are exchanged, never your identity.</string>
    <string name="bluetooth_permission_bullet_zero_effort_title">Zero effort</string>
    <string name="bluetooth_permission_bullet_zero_effort_subtitle">Sensing runs quietly in the background. Nothing to tap.</string>
    <string name="bluetooth_permission_allow_button">Allow Bluetooth</string>
    <string name="bluetooth_permission_settings_note">You can change this anytime in Settings.</string>

    <!-- Screen 03: Bluetooth-off recovery (mirrors iOS's BluetoothOffView). -->
    <string name="bluetooth_off_title">Bluetooth is off</string>
    <string name="bluetooth_off_message">beid can\'t sense events or collect proofs while Bluetooth is off.</string>
    <string name="bluetooth_off_step_open_settings">Open Settings</string>
    <string name="bluetooth_off_step_tap_bluetooth">Tap Bluetooth</string>
    <string name="bluetooth_off_step_switch_on">Switch it on</string>
    <string name="bluetooth_off_open_settings_button">Open Settings</string>
    <string name="bluetooth_off_turned_on_button">I\'ve turned it on</string>

    <string name="event_join_title">Join an event</string>
    <string name="event_join_code_label">Event code</string>
    <string name="event_join_button">Join event</string>
    <string name="event_join_status_idle">Enter the event code shared by the organizer.</string>
    <string name="event_join_status_requesting_permission">Requesting Bluetooth permission…</string>
    <string name="event_join_status_sensing">Sensing for nearby peers…</string>
    <string name="event_join_status_permission_denied">beid needs Bluetooth permission to sense nearby peers. Open Settings to grant it.</string>
    <string name="event_join_open_settings">Open Settings</string>
    <string name="event_join_error_empty_code">Enter an event code to continue. Ask the event organizer for it.</string>
    <string name="event_join_error_join_failed">beid couldn\'t join that event. Check the code and try again.</string>
    <string name="event_join_searching_nearby">Searching for nearby events…</string>
    <string name="event_join_rescue_guidance">You can enter a code from Account if no event appears.</string>
    <string name="event_join_beacon_name_label">Name announced by nearby beacon</string>
    <string name="event_join_beacon_name_missing">No name announced by nearby beacon</string>
    <string name="event_join_validity_period">Valid from %1$d to %2$d</string>
    <string name="event_join_not_joinable_yet">Waiting for event verification</string>
    <string name="event_join_selected">Selected</string>

    <!-- Peer first detected but not yet confirmed as a real event (below the confirm threshold). -->
    <string name="event_join_status_event_found">Event found — waiting to confirm…</string>
    <string name="event_join_status_recording">Recording</string>
    <!-- "Signal lost" here is our own manual/simulated trigger, not a real Bluetooth radio outage. -->
    <string name="event_join_status_signal_lost">Signal lost — recording paused</string>
    <string name="event_join_peers_verified_label">Peers verified</string>
    <!-- Status pill dot label — sensing is actively running (mirrors iOS's BeidStatusPill.State.sensingAutomatically). -->
    <string name="event_join_status_pill_active">Sensing automatically</string>
    <!-- Status pill dot label — sensing is paused (signal lost; mirrors iOS's BeidStatusPill.State.sensingPaused). -->
    <string name="event_join_status_pill_paused">Sensing paused</string>
    <!-- Verb: resumes a paused recording session in place, does not restart it. -->
    <string name="event_join_resume_sensing">Resume</string>
    <!-- Manual affordance standing in for real signal-loss detection, which does not exist yet on Android. -->
    <string name="event_join_simulate_signal_lost">Simulate signal lost</string>

    <!-- Scan flow (beid#336): Sensing/Event Found/Recording/Signal Lost full-screen bodies shown inside EventJoinScreen once a session reaches EventJoinUiState.Sensing — mirrors iOS's ScanFlowView (screens 05-07/06d). -->
    <string name="scan_sensing_message">Walk into an event — it will show up here automatically.</string>
    <string name="scan_event_found_title">Event Found</string>
    <string name="scan_event_found_message">Verification starts automatically — stay nearby</string>
    <!-- One-time entrance-ceremony header shown the instant Recording begins, mirrors iOS's retired ProofCollectedView copy. -->
    <string name="scan_recording_ceremony_title">Proof Collected</string>
    <string name="scan_recording_ceremony_subtitle">Added to your collection.</string>
    <string name="scan_signal_lost_title">Signal Lost</string>
    <!-- %1$s is the event code — Android's ScanEventSession has no event display name yet (see beid#336's data-gap note), unlike iOS's richer EventSession.name. -->
    <string name="scan_signal_lost_message">beid lost the connection to %1$s. Move closer and we\'ll pick it back up automatically.</string>

    <!-- Reused for both the nav entry-point label on EventJoinScreen (tap target that opens the Account screen) and the Account screen's own title, so both say the same word. -->
    <string name="account_title">Account</string>
    <string name="account_manual_event_code_button">Enter event code</string>

    <!-- Screen 09-equivalent: Account (mirrors iOS's AccountSheetView, minus wallet/Venue Device/Past Events — see beid#126). -->
    <string name="account_bluetooth_label">Bluetooth</string>
    <!-- Bluetooth status badge text: the phone's Bluetooth radio is powered on. Not "in use" or "connected to a device" — just radio power state. -->
    <string name="account_bluetooth_status_on">Active</string>
    <!-- Bluetooth status badge text: the phone's Bluetooth radio is powered off. -->
    <string name="account_bluetooth_status_off">Off</string>
    <!-- Destructive-named (not destructive-colored) action: leaves the currently joined event. -->
    <string name="account_leave_event_button">Leave Event</string>
    <!-- Nav row on the Account screen (mirrors iOS's AccountSheetView "Past Events" row) that opens the Records screen. -->
    <string name="account_records_button">Records</string>

    <!-- Records screen (beid#121): flat, reverse-chronological list of collected proofs, reached from Account. Reduced scope — no event grouping, no tap-to-detail; see RecordsScreen.kt's kdoc. -->
    <string name="records_title">Records</string>
    <!-- Empty state, shown when this device has never recorded a proof. -->
    <string name="records_empty_message">Proofs you collect will appear here.</string>
    <!-- Signature status pill — no self-proof or binding evidence recorded yet for this proof. -->
    <string name="records_signature_status_not_signed">Not yet signed</string>
    <!-- Signature status pill — an owner-key self-proof has been recorded, but no wallet binding yet. -->
    <string name="records_signature_status_self_proof">Self-proof recorded</string>
    <!-- Signature status pill — a wallet binding has been recorded for this proof, the strongest of the three states. -->
    <string name="records_signature_status_bound">Bound</string>

    <!-- Entry from Records into a separate day-scoped summary surface (beid#342). -->
    <string name="records_today_button">Today</string>
    <string name="today_summary_title">Today</string>
    <plurals name="today_summary_record_count">
        <item quantity="one">%d proof collected today</item>
        <item quantity="other">%d proofs collected today</item>
    </plurals>
    <string name="today_summary_empty_title">No proofs yet today</string>
    <string name="today_summary_empty_message">Proofs you collect today will show up here.</string>
    <string name="today_summary_submission_title">Submission</string>
    <string name="today_summary_submission_enabled">Not sent yet.</string>
    <string name="today_summary_submission_disabled">Sending isn\'t turned on for this build.</string>

    <!-- Record detail screen (beid#122), reached by tapping a Records row. Own per-row vocabulary — never reuses records_signature_status_* (the list's derived-pill vocabulary) and never claims "Verified" (beid#144 is unowned; beid#240). -->
    <!-- Metric row label paired with a device count. "Devices", not people: distinct nearby devices sensed during the event, each counted once however long it stayed. Does not imply mutual/reciprocal confirmation. Matches iOS's "detail.devicesSensed.label" wording on its own Proof Detail screen. -->
    <string name="record_detail_devices_sensed_label">Devices sensed</string>
    <!-- Independent row label: whether an owner-key self-proof has been recorded for this proof (device-signed, presence-based — see ProofRecord.hasSelfProof). Not a claim of third-party verification. -->
    <string name="record_detail_self_proof_label">Self-proof</string>
    <!-- Independent row label: whether a wallet owner-key binding has been recorded for this proof (presence-based — see ProofRecord.hasBinding). Not a claim of third-party verification. -->
    <string name="record_detail_binding_label">Owner-key binding</string>
    <!-- Independent row label: whether two devices have confirmed they mutually sensed each other for this proof. Always shows record_detail_not_yet_available — on-device mutual/reciprocal confirmation is structurally unmeasurable today, not merely uncaptured (beid#222). -->
    <string name="record_detail_mutual_confirmation_label">Mutual confirmation</string>
    <!-- Independent row label: the time-band buildup of devices sensed across this session. Always shows record_detail_not_yet_available — Android has no aggregation producer yet (beid#327). -->
    <string name="record_detail_time_band_buildup_label">Time-band buildup</string>
    <!-- Trailing value for an independent row above whose evidence has been recorded on this device. -->
    <string name="record_detail_recorded">Recorded</string>
    <!-- Trailing value for an independent row above with nothing to show yet — either the capability doesn\'t exist in the product yet, or it exists but hasn\'t happened for this proof yet. Means there is nothing to report, not that an attempt was made and failed; never an error/warning/declined state. -->
    <string name="record_detail_not_yet_available">Not yet available</string>
</resources>
